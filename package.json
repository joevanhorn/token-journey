{
  "name": "token-journey",
  "version": "1.0.0",
  "description": "Visualize OAuth/OIDC and agentic token flows as a plain-language story and an animated sequence diagram.",
  "main": "viewer/token-journey.js",
  "files": [
    "viewer/",
    "recorder/js/",
    "schema/",
    "adapters/"
  ],
  "scripts": {
    "test": "node --test tests/",
    "test:py": "python3 -m unittest discover tests",
    "test:render": "python3 tests/render_smoke.py",
    "examples": "python3 examples/build_examples.py",
    "serve": "python3 -m http.server 8000"
  },
  "keywords": [
    "oauth",
    "oidc",
    "token-exchange",
    "rfc8693",
    "jwt",
    "agentic",
    "mcp",
    "identity",
    "visualization",
    "sequence-diagram"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joevanhorn/token-journey.git"
  },
  "homepage": "https://github.com/joevanhorn/token-journey#readme"
}
